#version 450

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

// 漫反射预积分:对每个方向,在法线半球上平均采样环境贴图,得到辐照度图。
layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(binding = 0) uniform samplerCube env_tex;
layout(rgba32f, binding = 1) uniform writeonly image2DArray irradiance_tex;

layout(push_constant) uniform Constants {
    uint sample_count;
    float delta_phi;
    float delta_theta;
} pc;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    ivec3 dim = imageSize(irradiance_tex);
    if (gid.x >= dim.x || gid.y >= dim.y || gid.z >= 6) {
        return;
    }
    vec2 uv = (vec2(gid.xy) + 0.5) / vec2(dim.xy);
    vec3 n = normalize(cube_dir(gid.z, uv));

    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, n));
    vec3 up2 = cross(n, right);

    vec3 irradiance = vec3(0.0);
    float phi = 0.0;
    float nr = 0.0;
    for (uint s = 0; s < pc.sample_count; s++) {
        float theta = 0.0;
        for (uint t = 0; t < pc.sample_count; t++) {
            vec3 tangent = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 dir = right * tangent.x + up2 * tangent.y + n * tangent.z;
            irradiance += texture(env_tex, dir).rgb * cos(theta) * sin(theta);
            nr += 1.0;
            theta += pc.delta_theta;
        }
        phi += pc.delta_phi;
    }
    irradiance *= PI * (1.0 / nr);
    imageStore(irradiance_tex, gid, vec4(irradiance, 1.0));
}
