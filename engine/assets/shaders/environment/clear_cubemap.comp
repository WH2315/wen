#version 450

// 把立方体贴图(2D array,6 层)清除为纯黑。
// 用于无 default_env.hdr 时的兜底:天空渲染为黑、IBL 为 0。
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform writeonly image2DArray cube_tex;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    ivec3 dim = imageSize(cube_tex);
    if (gid.x < dim.x && gid.y < dim.y && gid.z < 6) {
        imageStore(cube_tex, gid, vec4(0.0));
    }
}
