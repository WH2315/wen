#version 450

#extension GL_GOOGLE_include_directive : require

#include "types.glsl"

layout(std430, binding = 0) readonly buffer Counts {
    uint visible_mesh_instance_count;
    uint available_indirect_command_count;
};

layout(std430, binding = 1) readonly buffer VisibleMeshInstanceIndices {
    uvec2 visible_mesh_instance_indices[];
};

layout(std430, binding = 3) buffer IndirectCommands {
    VkDrawIndexedIndirectCommand indirect_commands[];
};

layout(std430, binding = 5) writeonly buffer InstanceData {
    vec4 instance_datas[];
};

layout(std430, binding = 7) writeonly buffer OutliningBuffer {
    vec4 outlining_instance_datas[3];
    VkDrawIndexedIndirectCommand outlining_command;
};

// 5.将可见的 MeshInstance 索引压缩到连续的缓冲区中
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint mesh_instance_index = gl_GlobalInvocationID.x;
    if (mesh_instance_index >= visible_mesh_instance_count) {
        return;
    }

    uvec2 instance_info = visible_mesh_instance_indices[mesh_instance_index];
    MeshInstance mesh_instance = mesh_instances[instance_info.x];
    uint mesh_id = mesh_instance.mesh_id;
    uint primitive_index = mesh_descriptors[mesh_id].lods[instance_info.y];
    uint offset = 9 * (indirect_commands[primitive_index].first_instance + atomicAdd(indirect_commands[primitive_index].instance_count, 1));
    instance_datas[offset + 0] = vec4(mesh_instance.location, instance_info.x);
    instance_datas[offset + 1] = vec4(mesh_instance.rotation, 0);
    instance_datas[offset + 2] = vec4(mesh_instance.scale, 0);
    instance_datas[offset + 3] = vec4(mesh_instance.base_color, float(mesh_instance.texture_index));
    // .w 存 lod_index,供 mesh shader 的 LOD 调试着色使用(instance_info.y = 选中的 LOD 层级)。
    instance_datas[offset + 4] = vec4(mesh_instance.metallic, mesh_instance.roughness, 0, float(instance_info.y));
    instance_datas[offset + 5] = vec4(mesh_instance.emissive_color, mesh_instance.emissive_intensity);
    instance_datas[offset + 6] = vec4(mesh_instance.tiling, 0, 0);
    // 第 8 个 vec4:法线贴图 (index, scale)
    instance_datas[offset + 7] = vec4(float(mesh_instance.normal_texture_index), mesh_instance.normal_scale, 0, 0);
    // 第 9 个 vec4:MR/AO (mr_index, ao_index, ao_intensity)
    instance_datas[offset + 8] = vec4(float(mesh_instance.mr_texture_index), float(mesh_instance.ao_texture_index), mesh_instance.ao_intensity, 0);

    // 选中的实例可见时，为 outlining pass 写入实例数据和间接绘制命令
    // (reset_indirect_command.comp 每帧清零 instance_count，选中物被剔除时不残留)
    if (instance_info.x == selected_mesh_instance_index) {
        outlining_instance_datas[0] = vec4(mesh_instance.location, 0);
        outlining_instance_datas[1] = vec4(mesh_instance.rotation, 0);
        outlining_instance_datas[2] = vec4(mesh_instance.scale, 0);
        outlining_command.index_count = primitive_descriptors[primitive_index].index_count;
        outlining_command.instance_count = 1;
        outlining_command.first_index = primitive_descriptors[primitive_index].first_index;
        outlining_command.vertex_offset = primitive_descriptors[primitive_index].vertex_offset;
        outlining_command.first_instance = 0;
    }
}
